# Manual integration host for Windows adapter work.
#
#   cp .env.local.example .env.local     and fill in .env.local
#
# .env.local is gitignored and a test fails if it is ever tracked. This example
# file is committed; it must never contain a real value.
#
# Nothing in the shipped application reads this. It is only for the manual
# integration runs and the capture script, because the Windows adapter cannot be
# written without real output from a real Windows box (CONTRIBUTING rule 4).

LITEDECK_TEST_WIN_HOST=
LITEDECK_TEST_WIN_PORT=22
LITEDECK_TEST_WIN_USER=

# --- Authentication: pick one -------------------------------------------------
#
# A dedicated key is strongly preferred.
#
# The password path needs expect(1) to feed the prompt, and anything expect
# drives is visible in the process table and in expect's own logging — which is
# exactly what CONTRIBUTING rule 6 forbids for the app itself ("비밀은 argv에
# 넣지 않습니다"). Holding the tooling to a lower standard than the product is
# how a password ends up in a terminal scrollback.
#
# Generate a key that exists only for this box:
#
#   ssh-keygen -t ed25519 -N '' -C 'litedeck-dev' -f testdata/windows/id_litedeck_dev
#
# Then install the public half on the Windows server. Note the location: for a
# member of the Administrators group, Windows OpenSSH ignores ~/.ssh/authorized_keys
# and reads a single shared file instead. Putting it in the usual place is the
# most common reason key auth "silently" fails there.
#
#   # in an elevated PowerShell on the Windows box
#   $k = '<paste the contents of id_litedeck_dev.pub>'
#   Add-Content C:\ProgramData\ssh\administrators_authorized_keys $k
#   icacls C:\ProgramData\ssh\administrators_authorized_keys /inheritance:r /grant 'Administrators:F' /grant 'SYSTEM:F'
#
# The icacls line is not optional — sshd refuses the file if any other account
# can write to it, and logs the refusal only on the server.

LITEDECK_TEST_WIN_KEY=testdata/windows/id_litedeck_dev

# Fallback only. Leave empty when using a key.
LITEDECK_TEST_WIN_PASSWORD=
